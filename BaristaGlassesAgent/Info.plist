<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key><string>Barista</string>
    <key>UIFileSharingEnabled</key><true/>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <key>WiFiStreamingConfigured</key><string>$(WIFI_STREAMING_CONFIGURED)</string>
    <key>LocalPhotoSyncToken</key><string>$(PHOTO_SYNC_TOKEN)</string>
    <key>CFBundleURLTypes</key>
    <array><dict>
        <key>CFBundleTypeRole</key><string>Editor</string>
        <key>CFBundleURLName</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
        <key>CFBundleURLSchemes</key><array><string>baristaglassesagent</string></array>
    </dict></array>
    <key>MWDAT</key>
    <dict>
        <key>AppLinkURLScheme</key><string>baristaglassesagent://</string>
        <key>MetaAppID</key><string>$(META_APP_ID)</string>
        <key>ClientToken</key><string>$(CLIENT_TOKEN)</string>
        <key>TeamID</key><string>$(DEVELOPMENT_TEAM)</string>
    </dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
        <string>bluetooth-peripheral</string>
        <string>external-accessory</string>
    </array>
    <key>UISupportedExternalAccessoryProtocols</key>
    <array><string>com.meta.ar.wearable</string></array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Find and connect to your Meta glasses for camera streaming over Wi-Fi.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_bonjour._tcp</string>
        <string>_baristaphoto._tcp</string>
    </array>
</dict>
</plist>
