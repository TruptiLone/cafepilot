      },
      "reason": "Know how much milk and coffee we have as of Thursday 6 PM."
    },
    {
      "id": "demand",
      "action": "project_recipe_usage",
      "args": {
        "cafe_id": "CAFE001",
        "target_at": "2026-11-01T08:00:00-08:00",
        "items": [
          {
            "variation_id": "COF003_REG",
            "quantity": 40
          },
          {
            "variation_id": "COF003_REG",
            "quantity": 20,
            "modifiers": [
              {
                "modifier_id": "MILK_OAT",
                "quantity": 1
              }
            ]
          }
        ]
      },
      "reason": "Turn the extra lattes into milk and bean quantities."
    },
    {
      "id": "staff",
      "action": "list_employees",
      "args": {
        "cafe_id": "CAFE001"
      },
      "reason": "See who can work and in which role."
    },
    {
      "id": "shifts",
      "action": "list_shifts",
      "args": {
        "cafe_id": "CAFE001",
        "start_at": "2026-11-01T07:00:00-08:00",
        "end_at": "2026-11-01T15:00:00-08:00"
      },
      "reason": "Check existing Sunday shifts to avoid overlaps."
    },
    {
      "id": "coverage",
      "action": "coverage_report",
      "args": {
        "cafe_id": "CAFE001",
        "start_at": "2026-11-01T08:00:00-08:00",
        "end_at": "2026-11-01T14:00:00-08:00",
        "required_staff": 4
      },
      "reason": "Find understaffed hours during the market."
    },
    {
      "id": "short",
      "action": "calculate_shortfall",
      "args": {
        "cafe_id": "CAFE001",
        "as_of": "2026-10-29T18:00:00-07:00",
        "target_at": "2026-11-01T08:00:00-08:00",
        "items": [
          {
            "variation_id": "COF003_REG",
            "quantity": 40
          },
          {
            "variation_id": "COF003_REG",
            "quantity": 20,
