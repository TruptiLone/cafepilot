POSTGRES_DB=cafe_business_db
POSTGRES_USER=cafepilot
POSTGRES_PASSWORD=<local-development-placeholder>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Meta Model API (agent planner)
MODEL_API_KEY=
PLANNER_MODEL=muse-wonder-1.0
VISION_MODEL=muse-spark-1.3
