{
  "status": "plan",
  "goal": "Prepare milk stock and morning staffing for the Sunday Nov 1 farmers market.",
  "assumptions": [
    "Event adds 40 whole-milk lattes and 20 oat-milk lattes (12 oz) between 8 AM and 2 PM.",
    "Event-morning target is 4 people scheduled from 8 AM to 2 PM."
