POSTGRES_DB=cafe_business_db
POSTGRES_USER=cafepilot
POSTGRES_PASSWORD=<local-development-placeholder>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Meta Model API (agent planner)
MODEL_API_KEY=
PLANNER_MODEL=muse-wonder-1.0
VISION_MODEL=muse-spark-1.3
IMAGE_MODEL=muse-image-1.0

# Local glasses media receiver. Photos are copied to ~/Pictures/BaristaShared.
MEDIA_UPLOAD_TOKEN=
BARISTA_SHARED_PHOTOS_DIR=~/Pictures/BaristaShared

# Public demo (leave empty locally). PUBLIC_DEMO=1 hides /docs and refuses to start without an access code.
PUBLIC_DEMO=0
DEMO_ACCESS_CODE=
# Muse calls allowed per day (Pacific time); empty = no limit.
MUSE_DAILY_LIMIT=
# A private copy of the demo café per visitor. Build the template first:
#   PYTHONPATH=. python scripts/build_template.py
PER_VISITOR_DATABASES=0
TEMPLATE_DATABASE=cafepilot_template
MAX_VISITOR_DATABASES=15
VISITOR_IDLE_MINUTES=120
# The built web app, served by FastAPI (set in the container; leave unset locally, Vite serves it).
# FRONTEND_DIST=frontend/dist
